# Backend Environment Configuration (.env)

# Environment Mode ("development" or "production")
# production mode enforces strict SECRET_KEY checks and skips automatic DB seeding.
ENVIRONMENT=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URL=mongodb://localhost:27017

# Database Name
DATABASE_NAME=food_ordering

# JWT Secret Key (MUST be changed in production)
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=super-secret-restaurant-jwt-key-2026-change-in-production

# Comma-separated list of allowed origins for CORS (e.g. your frontend URL)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true if you want to force database seeding even in production
SEED_DB=false
